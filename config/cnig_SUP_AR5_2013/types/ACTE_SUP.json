{
    "id": "fa205814839e8a55050072052e9a9746",
    "name": "ACTE_SUP",
    "title": "ACTE_SUP",
    "description": "Table contenant la liste des actes instituant une servitude d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "3bcd8b17ef82f6bd433fba64f2deea9c",
            "name": "APLAN",
            "title": "APLAN",
            "description": "Existence d'un ou plusieurs plans annexés à l'acte",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "String",
            "id": "763c5053c4f38154acde4ea3e1041f9d",
            "name": "DECISION",
            "title": "DECISION",
            "description": "Nature de la décision prise dans l'acte : l'autorité compétente prend une décision qui crée ou modifie l'état de la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "f93bce4641120de347f0e13019cef5d9",
            "name": "TYPEACTE",
            "title": "TYPEACTE",
            "description": "Description de la nature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "e9bab9c8890b8bd13588258563a364c7",
            "name": "DATEPUB",
            "title": "DATEPUB",
            "description": "Date de parution au Journal Officiel ou de publicité dans la presse",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "String",
            "id": "9afd184bedbf246a8e0c1758543beef4",
            "name": "NOMACTE",
            "title": "NOMACTE",
            "description": "Nom abrégé de l'acte, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+(_[0-9]+)?_act",
                "maxLength": 100
            }
        },
        {
            "type": "Integer",
            "id": "b3b3b7f5faf5573016778553da428b50",
            "name": "IDACTE",
            "title": "IDACTE",
            "description": "Identifiant de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "String",
            "id": "faef18c573dc5a518e3cfd0650631c6b",
            "name": "DATEDECIS",
            "title": "DATEDECIS",
            "description": "Date à laquelle la décision a été prise. Il s'agit de la date de signature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "Filename",
            "id": "f3fb268b0904d251fc654f0f0582fffa",
            "name": "FICHIER",
            "title": "FICHIER",
            "description": "Nom ou référence du ficher contenant l'acte instituant la servitude. Ce fichier contient le cas échéant les plans annexés à l'acte",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "cc4be43e9ee6d01b526af8c839c7a055",
            "name": "REFERENCE",
            "title": "REFERENCE",
            "description": "Référence de l'acte ayant créé ou modifié la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        }
    ],
    "constraints": {
        "conditions": [],
        "foreignKeys": [
            "(APLAN) REFERENCES ListeAplanSUP(APLAN)",
            "(TYPEACTE) REFERENCES ListeTypeacteSUP(TYPEACTE)",
            "(DECISION) REFERENCES ListeDecisionSUP(DECISION)"
        ]
    }
}