{
    "id": "e450a5485d5ca020cce5a544e0e0bbd2",
    "name": "ACTE_SUP",
    "title": "ACTE_SUP",
    "description": "Table contenant la liste des actes instituant une servitude d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "cf3d09d57172c7e92d36fe67ac7b53de",
            "name": "REFERENCE",
            "title": "REFERENCE",
            "description": "Référence de l'acte ayant créé ou modifié la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "7d9314e4e9d5399fd666615a297470d7",
            "name": "DECISION",
            "title": "DECISION",
            "description": "Nature de la décision prise dans l'acte : l'autorité compétente prend une décision qui crée ou modifie l'état de la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "048226cdcee1f689320729511fdfdc8a",
            "name": "DATEPUB",
            "title": "DATEPUB",
            "description": "Date de parution au Journal Officiel ou de publicité dans la presse",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "Filename",
            "id": "b481e6d43e7218f0305b092fa2183147",
            "name": "FICHIER",
            "title": "FICHIER",
            "description": "Nom ou référence du ficher contenant l'acte instituant la servitude. Ce fichier contient le cas échéant les plans annexés à l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "8bf468b22fd18800ee259d3391a0781a",
            "name": "IDACTE",
            "title": "IDACTE",
            "description": "Identifiant de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true,
                "pattern": "[a-zA-Z0-9]+-[0-9]{9}-[0-9]+-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "7c2869ab0b128fc0eab83a1b014fd967",
            "name": "APLAN",
            "title": "APLAN",
            "description": "Existence d'un ou plusieurs plans annexés à l'acte",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "String",
            "id": "68c074f1b723f3b96dbca8ccc5171d03",
            "name": "TYPEACTE",
            "title": "TYPEACTE",
            "description": "Description de la nature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "84af36238ac4172a5e707d047ea344c6",
            "name": "DATEDECIS",
            "title": "DATEDECIS",
            "description": "Date à laquelle la décision a été prise. Il s'agit de la date de signature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "String",
            "id": "48e8f86f3d68b618b7a114e5fef26e56",
            "name": "NOMACTE",
            "title": "NOMACTE",
            "description": "Nom abrégé de l'acte, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+_[A-Za-z0-9_-]+_[0-9]{8}_act",
                "maxLength": 100
            }
        }
    ],
    "constraints": {
        "conditions": [],
        "foreignKeys": [
            "(APLAN) REFERENCES ListeAplanSUP(APLAN)",
            "(DECISION) REFERENCES ListeDecisionSUP(DECISION)",
            "(TYPEACTE) REFERENCES ListeTypeacteSUP(TYPEACTE)"
        ]
    }
}