{
    "id": "2fc429e9ea717b531c9107d3b957215d",
    "name": "SERVITUDE",
    "title": "SERVITUDE",
    "description": "Table contenant la liste des servitudes d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "143b29287dbe2011e240eb1da3c74c87",
            "name": "VALIDEGEST",
            "title": "VALIDEGEST",
            "description": "Les données numérisées de la servitude ont été validées ou pas par le gestionnaire",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "Url",
            "id": "08f6af085cab8b97f803cb36181a0406",
            "name": "URLREG",
            "title": "URLREG",
            "description": "Lien d’accès au fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "e9b3b9362987f0b49a2d6461e61f20b2",
            "name": "DATEMAJ",
            "title": "DATEMAJ",
            "description": "Date de la dernière modification apportée à la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "String",
            "id": "68dd94214c40ca3d7afe78a62c577b98",
            "name": "IDSUP",
            "title": "IDSUP",
            "description": "Identifiant de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true,
                "pattern": "[a-zA-Z0-9]+-[0-9]{9}-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "120e290face8206d563340ad70565885",
            "name": "CATEGORIE",
            "title": "CATEGORIE",
            "description": "Catégorie de la servitude dans la nomenclature nationale",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 10
            }
        },
        {
            "type": "String",
            "id": "c8f21ea46fc5de0093d46c7f4850b115",
            "name": "QUIPROD",
            "title": "QUIPROD",
            "description": "Organisme ayant numérisé la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        },
        {
            "type": "String",
            "id": "3642ac3b29959de5d72da6b63155fa22",
            "name": "OBSVALIDAT",
            "title": "OBSVALIDAT",
            "description": "Observation relative à la validation de la servitude formulée soit par le gestionnaire, soit par le service de l'État administrant les données",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "fc001f2c24c613bfd507437ad798ff0d",
            "name": "DESCRIPTIO",
            "title": "DESCRIPTIO",
            "description": "Description détaillée de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "9775dde00e5be3af16a162122ebb8c16",
            "name": "MODEPROD",
            "title": "MODEPROD",
            "description": "Mode d'obtention de la SUP : import de données échangées avec les gestionnaires ; numérisation (digitalisation) de la SUP annexée au document d'urbanisme ; ou reconstitution à partir de l'acte l'instituant",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "749923320b188a42c6d536a605371c0f",
            "name": "IDGEST",
            "title": "IDGEST",
            "description": "Identifiant du gestionnaire de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 9
            }
        },
        {
            "type": "String",
            "id": "52944ed118d681b5ee03bb642031cb16",
            "name": "NOMREG",
            "title": "NOMREG",
            "description": "Nom du fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+_[A-Za-z0-9_-]+_[0-9]{8}_reg.pdf",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "bdbbb8b259142fbb7f242ccd440d21f3",
            "name": "IDINTGEST",
            "title": "IDINTGEST",
            "description": "Identifiant créé et entretenu par l'organisme gestionnaire de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "723af01e95c34efb07be7b5ec0c5fbaa",
            "name": "NOMSUPLITT",
            "title": "NOMSUPLITT",
            "description": "Nom littéral de la servitude, figurant dans l'acte l'ayant instaurée",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 100
            }
        },
        {
            "type": "Integer",
            "id": "4947448e9179cf404afcf6bbdd8512de",
            "name": "ECHNUM",
            "title": "ECHNUM",
            "description": "Dénominateur de l'échelle à laquelle a été numérisée la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "2f9fe6adf65624fa82a4d313e915e241",
            "name": "NOMSUP",
            "title": "NOMSUP",
            "description": "Nom abrégé de la servitude, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+_[A-Za-z0-9_-]+_sup",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "50288bdf61009cae852d302cb62cddf0",
            "name": "DOCSOURCE",
            "title": "DOCSOURCE",
            "description": "Document graphique ayant été numérisé",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        }
    ],
    "constraints": {
        "conditions": [
            "QUIPROD IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'",
            "DOCSOURCE IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'"
        ],
        "foreignKeys": [
            "(CATEGORIE) REFERENCES ListeCategorieSUP(CATEGORIE)",
            "(MODEPROD) REFERENCES ListeModeprodSUP(MODEPROD)",
            "(VALIDEGEST) REFERENCES ListeValidegestSUP(VALIDEGEST)",
            "(IDGEST) REFERENCES GESTIONNAIRE_SUP(IDGEST)"
        ]
    }
}