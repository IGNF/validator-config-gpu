{
    "id": "bf83c585db545c2432eeee208ff167bb",
    "name": "EL7_ASSIETTE_SUP_S",
    "title": "EL7_ASSIETTE_SUP_S",
    "description": "Table contenant les assiettes surfaciques des servitudes de la catégorie EL7",
    "columns": [
        {
            "type": "String",
            "id": "efbd0c95f7511975cab15c8ef0d758ba",
            "name": "IDASS",
            "title": "IDASS",
            "description": "Identifiant de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?-[0-9]{9}-[0-9]+-[0-9]+-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "3abdd70a525ca9266d896ac086daa7bd",
            "name": "IDGEN",
            "title": "IDGEN",
            "description": "Identifiant du générateur de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?-[0-9]{9}-[0-9]+-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "37513b1cdd37b27ae78877dd5a5b64d4",
            "name": "SRCGEOASS",
            "title": "SRCGEOASS",
            "description": "Type de carte, de référentiel géographique utilisé en tant que source de géoréférencement lors de la digitalisation de la géométrie",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 30
            }
        },
        {
            "type": "String",
            "id": "5b059fd32e412e27082680de568a949a",
            "name": "DATESRCASS",
            "title": "DATESRCASS",
            "description": "Date d'actualité du référentiel utilisé lors du géoréférencement de l'objet. Il s'agit d'indiquer le millésime des données référentielles source",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "([0-9]{4}((0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|0000))"
            }
        },
        {
            "type": "String",
            "id": "6ba1a57b0f9386be3acae0ca52376cb1",
            "name": "MODEGEOASS",
            "title": "MODEGEOASS",
            "description": "Description de la méthode utilisée pour générer la géométrie de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "Integer",
            "id": "2d7be2beca5b8027195d4b58ce6f970b",
            "name": "PARAMCALC",
            "title": "PARAMCALC",
            "description": "Valeur du paramètre ayant permis de calculer l'assiette lorsque celle-ci correspond à un objet tampon",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "333875a246b7561ac78651c3f2498a37",
            "name": "TYPEASS",
            "title": "TYPEASS",
            "description": "Nature de l'assiette selon sa vocation principale",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "enum": [
                    "Plan d'alignement"
                ],
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "6fb5db93f2137834b76d2fab62a7a2cd",
            "name": "NOMASS",
            "title": "NOMASS",
            "description": "Nom abrégé de l'assiette, respectant les règles de nommage des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+(_gen[0-9]+)?_ass",
                "maxLength": 100
            }
        },
        {
            "type": "MultiPolygon",
            "id": "d889bf59f10b6fecb4fecd98c312421e",
            "name": "WKT",
            "title": "Géométrie",
            "description": "Géométrie associée",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        }
    ],
    "constraints": {
        "conditions": [
            "SRCGEOASS IS NOT NULL OR MODEGEOASS NOT IN ('Digitalisation', 'Liste de coordonnées')",
            "DATESRCASS IS NOT NULL OR SRCGEOASS IS NULL",
            "DATESRCASS IS NOT NULL OR MODEGEOASS NOT LIKE 'Liste de parcelles'",
            "PARAMCALC IS NOT NULL OR MODEGEOASS NOT LIKE 'Zone tampon'"
        ],
        "foreignKeys": [
            "(MODEGEOASS) REFERENCES ListeModegeoassSUP(MODEGEOASS)"
        ]
    }
}