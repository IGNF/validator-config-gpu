{
    "id": "920019a5549b76af69151f8e0764612a",
    "name": "SERVITUDE_ACTE_SUP",
    "title": "SERVITUDE_ACTE_SUP",
    "description": "Table exprimant la relation entre les servitudes et les actes instituant ces servitudes",
    "columns": [
        {
            "type": "String",
            "id": "7323afcc333c0b49d1491e8c54af8522",
            "name": "IDACTE",
            "title": "IDACTE",
            "description": "Identifiant de l'acte instituant la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?-[0-9]{9}-[0-9]+-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "db7f6d5c6768840b476afbd0114d782b",
            "name": "IDSUP",
            "title": "IDSUP",
            "description": "Identifiant de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?-[0-9]{9}-[0-9]+",
                "maxLength": 40
            }
        }
    ],
    "constraints": {
        "conditions": [
            "IDACTE LIKE IDSUP || '-%'"
        ],
        "foreignKeys": [
            "(IDACTE) REFERENCES ACTE_SUP(IDACTE)",
            "(IDSUP) REFERENCES SERVITUDE(IDSUP)"
        ]
    }
}