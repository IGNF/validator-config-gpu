{
    "id": "7c27cf830f717a411f0a1ee06bee30cc",
    "name": "SERVITUDE_ACTE_SUP",
    "title": "SERVITUDE_ACTE_SUP",
    "description": "Table exprimant la relation entre les servitudes et les actes instituant ces servitudes",
    "columns": [
        {
            "type": "String",
            "id": "def251de7516d939f6987d7f54f15bb7",
            "name": "IDACTE",
            "title": "IDACTE",
            "description": "Identifiant de l'acte instituant la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+-[0-9]{9}-[0-9]+-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "26bfb86e7000acf190a94da6e8e73336",
            "name": "IDSUP",
            "title": "IDSUP",
            "description": "Identifiant de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+-[0-9]{9}-[0-9]+",
                "maxLength": 40
            }
        }
    ],
    "constraints": {
        "conditions": [
            "IDACTE LIKE IDSUP || '-%'"
        ],
        "foreignKeys": [
            "(IDACTE) REFERENCES ACTE_SUP(IDACTE)",
            "(IDSUP) REFERENCES SERVITUDE(IDSUP)"
        ]
    }
}