{
    "id": "7b07754a1d42a8907aac62b69a6492e6",
    "name": "EL2bis_ASSIETTE_SUP_S",
    "title": "EL2bis_ASSIETTE_SUP_S",
    "description": "Table contenant les assiettes surfaciques des servitudes de la catégorie EL2bis",
    "columns": [
        {
            "type": "String",
            "id": "9a31f456548e5d33f9758bc665de9373",
            "name": "TYPEASS",
            "title": "TYPEASS",
            "description": "Nature de l'assiette selon sa vocation principale et la catégorie de SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 40
            }
        },
        {
            "type": "Integer",
            "id": "3959ec77f293bc89c1997cb7830fb933",
            "name": "IDASS",
            "title": "IDASS",
            "description": "Identifiant de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "Integer",
            "id": "1855c10ab5924ce14cc4d00217e536bb",
            "name": "IDGEN",
            "title": "IDGEN",
            "description": "Identifiant du générateur de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "d89b0788fcb7c579ecd898c83ef189bb",
            "name": "DATESRCASS",
            "title": "DATESRCASS",
            "description": "Date d'actualité du référentiel utilisé lors du géoréférencement de l'objet. Il s'agit d'indiquer le millésime des données référentielles source",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "([0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|00000000)"
            }
        },
        {
            "type": "String",
            "id": "62bbfb24a2c7b4d7d66af342508ff41d",
            "name": "MODEGEOASS",
            "title": "MODEGEOASS",
            "description": "Description de la méthode utilisée pour générer la géométrie de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "Integer",
            "id": "253b89ec3f64523d8f4d08e54753b3ef",
            "name": "PARAMCALC",
            "title": "PARAMCALC",
            "description": "Valeur du paramètre ayant permis de calculer l'assiette lorsque celle-ci correspond à un objet tampon",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "cfee0c25ea2fdf8472cfe828d8d41a41",
            "name": "SRCGEOASS",
            "title": "SRCGEOASS",
            "description": "Type de carte, de référentiel géographique utilisé en tant que source de géoréférencement lors de la digitalisation de la géométrie",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 30
            }
        },
        {
            "type": "String",
            "id": "1d30c056bd5e2b43e7860424eb30045a",
            "name": "NOMASS",
            "title": "NOMASS",
            "description": "Nom abrégé de l'assiette, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+(_gen[0-9]+)?_(mh|abor|ass|zpr1|zpr2|ziso|pepi|pepr|pepe|zhlg|zmcp|zpro|zgar|zpri|zsec|zspe|sect|zatt|zsur)",
                "maxLength": 100
            }
        },
        {
            "type": "MultiPolygon",
            "id": "3da21b799664c206f740d67a27dd6bd3",
            "name": "WKT",
            "title": "Géométrie",
            "description": "Géométrie associée",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        }
    ],
    "constraints": {
        "conditions": [
            "PARAMCALC IS NOT NULL OR MODEGEOASS NOT LIKE 'Zone tampon'",
            "SRCGEOASS IS NOT NULL OR MODEGEOASS NOT LIKE 'Digitalisation'"
        ],
        "foreignKeys": [
            "(MODEGEOASS) REFERENCES ListeModegeoassSUP(MODEGEOASS)"
        ]
    }
}