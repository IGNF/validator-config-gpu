            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "String",
            "id": "e681247ef3a91e252b2e28b83f7bc52f",
            "name": "HREF",
            "title": "HREF",
            "constraints": {
