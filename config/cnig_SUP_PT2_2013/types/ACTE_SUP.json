{
    "id": "6daa5d82daf2cec9ba00878f81bd2e63",
    "name": "ACTE_SUP",
    "title": "ACTE_SUP",
    "description": "Table contenant la liste des actes instituant une servitude d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "edc8931dc9d53caba09e603afcbb8e86",
            "name": "APLAN",
            "title": "APLAN",
            "description": "Existence d'un ou plusieurs plans annexés à l'acte",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "String",
            "id": "e0eb873412e9acc7dc1df232ec83e7d5",
            "name": "DECISION",
            "title": "DECISION",
            "description": "Nature de la décision prise dans l'acte : l'autorité compétente prend une décision qui crée ou modifie l'état de la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "1cc0b4be6e4e820d5573316de353b565",
            "name": "TYPEACTE",
            "title": "TYPEACTE",
            "description": "Description de la nature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "af2447b1a380ead4b3adf4744e506007",
            "name": "DATEPUB",
            "title": "DATEPUB",
            "description": "Date de parution au Journal Officiel ou de publicité dans la presse",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "String",
            "id": "f8e41064b64f04bbacdb0e5f6a27f551",
            "name": "NOMACTE",
            "title": "NOMACTE",
            "description": "Nom abrégé de l'acte, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+_[A-Za-z0-9_-]+(_[0-9]+)?_act",
                "maxLength": 100
            }
        },
        {
            "type": "Integer",
            "id": "f946a03eab3d3138f083137e06972583",
            "name": "IDACTE",
            "title": "IDACTE",
            "description": "Identifiant de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "String",
            "id": "2ba0d52444e31269e09d06488dd259eb",
            "name": "DATEDECIS",
            "title": "DATEDECIS",
            "description": "Date à laquelle la décision a été prise. Il s'agit de la date de signature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "Filename",
            "id": "afea18519e2ffe3c2c32b9ec5a03de05",
            "name": "FICHIER",
            "title": "FICHIER",
            "description": "Nom ou référence du ficher contenant l'acte instituant la servitude. Ce fichier contient le cas échéant les plans annexés à l'acte",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "dd3d08dc73d8800858f69f999f1a4ae5",
            "name": "REFERENCE",
            "title": "REFERENCE",
            "description": "Référence de l'acte ayant créé ou modifié la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        }
    ],
    "constraints": {
        "conditions": [],
        "foreignKeys": [
            "(APLAN) REFERENCES ListeAplanSUP(APLAN)",
            "(TYPEACTE) REFERENCES ListeTypeacteSUP(TYPEACTE)",
            "(DECISION) REFERENCES ListeDecisionSUP(DECISION)"
        ]
    }
}