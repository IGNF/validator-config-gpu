{
    "id": "5efcd3722d202280d553d1d13f6650cf",
    "name": "SERVITUDE",
    "title": "SERVITUDE",
    "description": "Table contenant la liste des servitudes d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "add0c6a445f359c92cbac90cde854952",
            "name": "VALIDEGEST",
            "title": "VALIDEGEST",
            "description": "Les données numérisées de la servitude ont été validées ou pas par le gestionnaire",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "Url",
            "id": "f7d966dc31178db98ad194c79858fc92",
            "name": "URLREG",
            "title": "URLREG",
            "description": "Lien d’accès au fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "9ff582fdf81823af482f8edf18e0de93",
            "name": "DATEMAJ",
            "title": "DATEMAJ",
            "description": "Date de la dernière modification apportée à la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "String",
            "id": "12f46468ca133037658da6f5014814d1",
            "name": "IDSUP",
            "title": "IDSUP",
            "description": "Identifiant de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true,
                "pattern": "[a-zA-Z0-9]+-[0-9]{9}-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "8ce8919fdefdfca8a609a7724af373f5",
            "name": "CATEGORIE",
            "title": "CATEGORIE",
            "description": "Catégorie de la servitude dans la nomenclature nationale",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 10
            }
        },
        {
            "type": "String",
            "id": "7bf07cab5da4dd2661b108e1df15e7e0",
            "name": "QUIPROD",
            "title": "QUIPROD",
            "description": "Organisme ayant numérisé la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        },
        {
            "type": "String",
            "id": "4bfc30cf049f56dd67991071844d45f1",
            "name": "OBSVALIDAT",
            "title": "OBSVALIDAT",
            "description": "Observation relative à la validation de la servitude formulée soit par le gestionnaire, soit par le service de l'État administrant les données",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "9a040b87f12cefb2aa0321e14565bd62",
            "name": "DESCRIPTIO",
            "title": "DESCRIPTIO",
            "description": "Description détaillée de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "d89682e74bee69b99ced1933e2efd500",
            "name": "MODEPROD",
            "title": "MODEPROD",
            "description": "Mode d'obtention de la SUP : import de données échangées avec les gestionnaires ; numérisation (digitalisation) de la SUP annexée au document d'urbanisme ; ou reconstitution à partir de l'acte l'instituant",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "f7c5f71bf36981f8ccf1449c91171722",
            "name": "IDGEST",
            "title": "IDGEST",
            "description": "Identifiant du gestionnaire de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 9
            }
        },
        {
            "type": "String",
            "id": "f9834a1f44169e2acc885b865b2cb0f8",
            "name": "NOMREG",
            "title": "NOMREG",
            "description": "Nom du fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+_[A-Za-z0-9_-]+_[0-9]{8}_reg.pdf",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "2f26fea801707bd68357f16df9a6fd0e",
            "name": "IDINTGEST",
            "title": "IDINTGEST",
            "description": "Identifiant créé et entretenu par l'organisme gestionnaire de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "338d8e4cee1519837622fcfdf6ef4580",
            "name": "NOMSUPLITT",
            "title": "NOMSUPLITT",
            "description": "Nom littéral de la servitude, figurant dans l'acte l'ayant instaurée",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 100
            }
        },
        {
            "type": "Integer",
            "id": "a6aed2f35d085b1e83d09a39d641ca8d",
            "name": "ECHNUM",
            "title": "ECHNUM",
            "description": "Dénominateur de l'échelle à laquelle a été numérisée la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "11cdb9658e53694fe3c7088a5acf53c6",
            "name": "NOMSUP",
            "title": "NOMSUP",
            "description": "Nom abrégé de la servitude, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+_[A-Za-z0-9_-]+_sup",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "f7e42e972f6352ae9e231dcb6d144c77",
            "name": "DOCSOURCE",
            "title": "DOCSOURCE",
            "description": "Document graphique ayant été numérisé",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        }
    ],
    "constraints": {
        "conditions": [
            "QUIPROD IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'",
            "DOCSOURCE IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'"
        ],
        "foreignKeys": [
            "(CATEGORIE) REFERENCES ListeCategorieSUP(CATEGORIE)",
            "(MODEPROD) REFERENCES ListeModeprodSUP(MODEPROD)",
            "(VALIDEGEST) REFERENCES ListeValidegestSUP(VALIDEGEST)",
            "(IDGEST) REFERENCES GESTIONNAIRE_SUP(IDGEST)"
        ]
    }
}