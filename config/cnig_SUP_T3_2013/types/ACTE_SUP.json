{
    "id": "5a803f18d41120a8b5f5df761b1caadf",
    "name": "ACTE_SUP",
    "title": "ACTE_SUP",
    "description": "Table contenant la liste des actes instituant une servitude d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "54e8e50b3a165c9e1b87f7cfa01a9bc7",
            "name": "APLAN",
            "title": "APLAN",
            "description": "Existence d'un ou plusieurs plans annexés à l'acte",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "String",
            "id": "ea6a5f1bc07af35d90ec041c48e7f771",
            "name": "DECISION",
            "title": "DECISION",
            "description": "Nature de la décision prise dans l'acte : l'autorité compétente prend une décision qui crée ou modifie l'état de la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "561c6daca392438329fd47c18715a2a6",
            "name": "TYPEACTE",
            "title": "TYPEACTE",
            "description": "Description de la nature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "22f9b09549a1466252d3ddb9f220e1f0",
            "name": "DATEPUB",
            "title": "DATEPUB",
            "description": "Date de parution au Journal Officiel ou de publicité dans la presse",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "([0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|00000000)"
            }
        },
        {
            "type": "String",
            "id": "e744a9a88ba401d7029e02fb5ff93a55",
            "name": "NOMACTE",
            "title": "NOMACTE",
            "description": "Nom abrégé de l'acte, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+(_[0-9]+)?_act",
                "maxLength": 100
            }
        },
        {
            "type": "Integer",
            "id": "0aad079cf20b19c19b430762082f8910",
            "name": "IDACTE",
            "title": "IDACTE",
            "description": "Identifiant de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "String",
            "id": "84bb5bb0d3730c8f24cb9a6f27ffd001",
            "name": "DATEDECIS",
            "title": "DATEDECIS",
            "description": "Date à laquelle la décision a été prise. Il s'agit de la date de signature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "([0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|00000000)"
            }
        },
        {
            "type": "Filename",
            "id": "c4376bafa4a8df67291fc17024073ae1",
            "name": "FICHIER",
            "title": "FICHIER",
            "description": "Nom ou référence du ficher contenant l'acte instituant la servitude. Ce fichier contient le cas échéant les plans annexés à l'acte",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "cb79721d4da3fc75eac1604fdb5f0ade",
            "name": "REFERENCE",
            "title": "REFERENCE",
            "description": "Référence de l'acte ayant créé ou modifié la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        }
    ],
    "constraints": {
        "conditions": [],
        "foreignKeys": [
            "(APLAN) REFERENCES ListeAplanSUP(APLAN)",
            "(TYPEACTE) REFERENCES ListeTypeacteSUP(TYPEACTE)",
            "(DECISION) REFERENCES ListeDecisionSUP(DECISION)"
        ]
    }
}