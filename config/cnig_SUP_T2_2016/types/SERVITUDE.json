{
    "id": "57c25194021fce960c9374b0ab66cc52",
    "name": "SERVITUDE",
    "title": "SERVITUDE",
    "description": "Table contenant la liste des servitudes d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "039a1311b3f456f6636b45d9e44d6877",
            "name": "VALIDEGEST",
            "title": "VALIDEGEST",
            "description": "Les données numérisées de la servitude ont été validées ou pas par le gestionnaire",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "Url",
            "id": "da858282e8c81070d58e91d900502c9e",
            "name": "URLREG",
            "title": "URLREG",
            "description": "Lien d’accès au fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "e31c061b5fed1d8e8e5c3081d02ae091",
            "name": "DATEMAJ",
            "title": "DATEMAJ",
            "description": "Date de la dernière modification apportée à la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "String",
            "id": "3beb1971fb0e0fe92d9e8e72976dac41",
            "name": "IDSUP",
            "title": "IDSUP",
            "description": "Identifiant de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?-[0-9]{9}-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "d8f71d00ea541ef442852fd6059c2f29",
            "name": "CATEGORIE",
            "title": "CATEGORIE",
            "description": "Catégorie de la servitude dans la nomenclature nationale",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 10
            }
        },
        {
            "type": "String",
            "id": "bcbe5bd96b356243e5dcf4351d1181a9",
            "name": "QUIPROD",
            "title": "QUIPROD",
            "description": "Organisme ayant numérisé la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        },
        {
            "type": "String",
            "id": "c1eeec7bb8990690ddd1e5e0d01829fa",
            "name": "OBSVALIDAT",
            "title": "OBSVALIDAT",
            "description": "Observation relative à la validation de la servitude formulée soit par le gestionnaire, soit par le service de l'État administrant les données",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "4d2297a03d8508f221553381a2e30fc9",
            "name": "DESCRIPTIO",
            "title": "DESCRIPTIO",
            "description": "Description détaillée de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "2a7dea837b172f2f82074e31b4073aa5",
            "name": "MODEPROD",
            "title": "MODEPROD",
            "description": "Mode d'obtention de la SUP : import de données échangées avec les gestionnaires ; numérisation (digitalisation) de la SUP annexée au document d'urbanisme ; ou reconstitution à partir de l'acte l'instituant",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "13669db9db81d1cfc8df66d96f4e964f",
            "name": "IDGEST",
            "title": "IDGEST",
            "description": "Identifiant du gestionnaire de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 9
            }
        },
        {
            "type": "String",
            "id": "383cb02c38bfac3df42773d4c27176dc",
            "name": "NOMREG",
            "title": "NOMREG",
            "description": "Nom du fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+_[0-9]{8}_reg.pdf",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "8837ce159fe0a84b5d856e033d2cc430",
            "name": "IDINTGEST",
            "title": "IDINTGEST",
            "description": "Identifiant créé et entretenu par l'organisme gestionnaire de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "60e727944c0644f0f6fce78822d5bac7",
            "name": "NOMSUPLITT",
            "title": "NOMSUPLITT",
            "description": "Nom littéral de la servitude, figurant dans l'acte l'ayant instaurée",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 100
            }
        },
        {
            "type": "Integer",
            "id": "e4315e61965f5a20696cd695be7bb09b",
            "name": "ECHNUM",
            "title": "ECHNUM",
            "description": "Dénominateur de l'échelle à laquelle a été numérisée la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "deecf633d1254863b6ed3c0dacaa348a",
            "name": "NOMSUP",
            "title": "NOMSUP",
            "description": "Nom abrégé de la servitude, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+_sup",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "44e67c6a0efd347d6c8782c64ef08559",
            "name": "DOCSOURCE",
            "title": "DOCSOURCE",
            "description": "Document graphique ayant été numérisé",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        }
    ],
    "constraints": {
        "conditions": [
            "QUIPROD IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'",
            "DOCSOURCE IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'"
        ],
        "foreignKeys": [
            "(CATEGORIE) REFERENCES ListeCategorieSUP(CATEGORIE)",
            "(MODEPROD) REFERENCES ListeModeprodSUP(MODEPROD)",
            "(VALIDEGEST) REFERENCES ListeValidegestSUP(VALIDEGEST)",
            "(IDGEST) REFERENCES GESTIONNAIRE_SUP(IDGEST)"
        ]
    }
}