{
    "id": "3edaf99a63374ef8435424ddabb62f33",
    "name": "SERVITUDE",
    "title": "SERVITUDE",
    "description": "Table contenant la liste des servitudes d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "d8ec598ff862b0270762f5dc5ed026c0",
            "name": "VALIDEGEST",
            "title": "VALIDEGEST",
            "description": "Les données numérisées de la servitude ont été validées ou pas par le gestionnaire",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "Url",
            "id": "8efe8e8f17481930c822080815f9cb62",
            "name": "URLREG",
            "title": "URLREG",
            "description": "Lien d’accès au fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "94a4df9ac5578c7a2015494f20fc20aa",
            "name": "DATEMAJ",
            "title": "DATEMAJ",
            "description": "Date de la dernière modification apportée à la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "([0-9]{4}((0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|0000))"
            }
        },
        {
            "type": "String",
            "id": "d8f09a62b0a74adc26376593a9a91b9b",
            "name": "IDSUP",
            "title": "IDSUP",
            "description": "Identifiant de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?-[0-9]{9}-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "96acc33b9d0527e5139cf9471e057018",
            "name": "CATEGORIE",
            "title": "CATEGORIE",
            "description": "Catégorie de la servitude dans la nomenclature nationale",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 10
            }
        },
        {
            "type": "String",
            "id": "723124959c34644873f1e1ea79d76988",
            "name": "QUIPROD",
            "title": "QUIPROD",
            "description": "Organisme ayant numérisé la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        },
        {
            "type": "String",
            "id": "0100787fe341b64eee77d25c76b3a6b6",
            "name": "OBSVALIDAT",
            "title": "OBSVALIDAT",
            "description": "Observation relative à la validation de la servitude formulée soit par le gestionnaire, soit par le service de l'État administrant les données",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "63d703c78e8e8362113928931fa8c7a9",
            "name": "DESCRIPTIO",
            "title": "DESCRIPTIO",
            "description": "Description détaillée de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "7541ab381f8d64a8e2ae4a64a2f658cb",
            "name": "MODEPROD",
            "title": "MODEPROD",
            "description": "Mode d'obtention de la SUP : import de données échangées avec les gestionnaires ; numérisation (digitalisation) de la SUP annexée au document d'urbanisme ; ou reconstitution à partir de l'acte l'instituant",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "1378d8738da8e954238eadce8b830cfa",
            "name": "IDGEST",
            "title": "IDGEST",
            "description": "Identifiant du gestionnaire de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{9}",
                "maxLength": 9
            }
        },
        {
            "type": "String",
            "id": "9f360b059dcce7738a393a6738267722",
            "name": "NOMREG",
            "title": "NOMREG",
            "description": "Nom du fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+_([0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|00000000)_reg\\.pdf",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "e7c40acffa052d5faad01cd7a3f4cf0b",
            "name": "IDINTGEST",
            "title": "IDINTGEST",
            "description": "Identifiant créé et entretenu par l'organisme gestionnaire de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "9b73be9e77f90444c9643887e3149111",
            "name": "NOMSUPLITT",
            "title": "NOMSUPLITT",
            "description": "Nom littéral de la servitude, figurant dans l'acte l'ayant instaurée",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 100
            }
        },
        {
            "type": "Integer",
            "id": "565df93e8fbe7fab2dd0c247f94658a6",
            "name": "ECHNUM",
            "title": "ECHNUM",
            "description": "Dénominateur de l'échelle à laquelle a été numérisée la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "c08b950dcc7174c6d841dc48652c28a6",
            "name": "NOMSUP",
            "title": "NOMSUP",
            "description": "Nom abrégé de la servitude, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+_sup",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "f190413d7a2a3c8647bc8baa3030fc04",
            "name": "DOCSOURCE",
            "title": "DOCSOURCE",
            "description": "Document graphique ayant été numérisé",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        }
    ],
    "constraints": {
        "conditions": [
            "QUIPROD IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'",
            "DOCSOURCE IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'"
        ],
        "foreignKeys": [
            "(CATEGORIE) REFERENCES ListeCategorieSUP(CATEGORIE)",
            "(MODEPROD) REFERENCES ListeModeprodSUP(MODEPROD)",
            "(VALIDEGEST) REFERENCES ListeValidegestSUP(VALIDEGEST)",
            "(IDGEST) REFERENCES GESTIONNAIRE_SUP(IDGEST)"
        ]
    }
}