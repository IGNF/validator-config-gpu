{
    "id": "1e8a1c29c5c58f0dca7e2574a0f1001e",
    "name": "T1_ASSIETTE_SUP_S",
    "title": "T1_ASSIETTE_SUP_S",
    "description": "Table contenant les assiettes ponctuels / linéaires / surfaciques liés aux servitudes de la catégorie CAT",
    "columns": [
        {
            "type": "String",
            "id": "c711a784606f5d376ddc858b929f4e96",
            "name": "TYPEASS",
            "title": "TYPEASS",
            "description": "Nature de l'assiette selon sa vocation principale et la catégorie de SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 40
            }
        },
        {
            "type": "Integer",
            "id": "10a56c84843c38be6951ad4899055455",
            "name": "IDASS",
            "title": "IDASS",
            "description": "Identifiant de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "Integer",
            "id": "7e10c8407d02598a96fcb428074af0c1",
            "name": "IDGEN",
            "title": "IDGEN",
            "description": "Identifiant du générateur de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "3de361ac8635f37b57ee624d1cb79532",
            "name": "DATESRCASS",
            "title": "DATESRCASS",
            "description": "Date d'actualité du référentiel utilisé lors du géoréférencement de l'objet. Il s'agit d'indiquer le millésime des données référentielles source",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "String",
            "id": "d7ac8b77801d59d6bc60796b7164fdc0",
            "name": "MODEGEOASS",
            "title": "MODEGEOASS",
            "description": "Description de la méthode utilisée pour générer la géométrie de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "Integer",
            "id": "0f75d9502e3582b0feefef5d7659082b",
            "name": "PARAMCALC",
            "title": "PARAMCALC",
            "description": "Valeur du paramètre ayant permis de calculer l'assiette lorsque celle-ci correspond à un objet tampon",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "aa1ecc54caf214524ab94f1317bcdc48",
            "name": "SRCGEOASS",
            "title": "SRCGEOASS",
            "description": "Type de carte, de référentiel géographique utilisé en tant que source de géoréférencement lors de la digitalisation de la géométrie",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 30
            }
        },
        {
            "type": "String",
            "id": "8174f2c6855711f6f679d12ee314f803",
            "name": "NOMASS",
            "title": "NOMASS",
            "description": "Nom abrégé de l'assiette, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+_[A-Za-z0-9_-]+(_gen[0-9]+)?_(mh|abor|ass|zpr1|zpr2|ziso|pepi|pepr|pepe|zhlg|zmcp|zpro|zgar|zpri|zsec|zspe|sect|zatt|zsur)",
                "maxLength": 100
            }
        },
        {
            "type": "Double",
            "id": "05ff9251d034759242df06ea82278658",
            "name": "H",
            "title": "H",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "MultiPolygon",
            "id": "46f9c7c40d2fc395b6a261acb7c935a1",
            "name": "WKT",
            "title": "Géométrie",
            "description": "Géométrie associée",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "String",
            "id": "8e499567db4dbf3b352629a4f4e02f57",
            "name": "HREF",
            "title": "HREF",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 3
            }
        }
    ],
    "constraints": {
        "conditions": [
            "PARAMCALC IS NOT NULL OR MODEGEOASS NOT LIKE 'Zone Tampon'",
            "SRCGEOASS IS NOT NULL OR MODEGEOASS NOT LIKE 'Digitalisation'"
        ],
        "foreignKeys": [
            "(MODEGEOASS) REFERENCES ListeModegeoassSUP(MODEGEOASS)",
            "(HREF) REFERENCES ListeHrefSUP(HREF)"
        ]
    }
}