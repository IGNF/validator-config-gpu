{
    "id": "f96303ea87f93a53451da016ff32c3b6",
    "name": "T6_ASSIETTE_SUP_S",
    "title": "T6_ASSIETTE_SUP_S",
    "description": "Table contenant les assiettes surfaciques des servitudes de la catégorie T6",
    "columns": [
        {
            "type": "String",
            "id": "d3f6862b4fa6b475c633409232bbc0a3",
            "name": "TYPEASS",
            "title": "TYPEASS",
            "description": "Nature de l'assiette selon sa vocation principale et la catégorie de SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 40
            }
        },
        {
            "type": "Integer",
            "id": "4e4d88d3a2f650c004aae2a01fb76c91",
            "name": "IDASS",
            "title": "IDASS",
            "description": "Identifiant de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "Integer",
            "id": "d8f61da1f43d101428ad338f232c9b16",
            "name": "IDGEN",
            "title": "IDGEN",
            "description": "Identifiant du générateur de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "6303c8a9e30e015a08b41afd1b680bd6",
            "name": "DATESRCASS",
            "title": "DATESRCASS",
            "description": "Date d'actualité du référentiel utilisé lors du géoréférencement de l'objet. Il s'agit d'indiquer le millésime des données référentielles source",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "([0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|00000000)"
            }
        },
        {
            "type": "String",
            "id": "7ad9110caed1fc32ff33f4e6800714db",
            "name": "MODEGEOASS",
            "title": "MODEGEOASS",
            "description": "Description de la méthode utilisée pour générer la géométrie de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "Integer",
            "id": "f18fec6fdf3a8fc9cccf93c8e5aea842",
            "name": "PARAMCALC",
            "title": "PARAMCALC",
            "description": "Valeur du paramètre ayant permis de calculer l'assiette lorsque celle-ci correspond à un objet tampon",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "7ddd2462b3ada35f54f87704cf4aaa0c",
            "name": "SRCGEOASS",
            "title": "SRCGEOASS",
            "description": "Type de carte, de référentiel géographique utilisé en tant que source de géoréférencement lors de la digitalisation de la géométrie",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 30
            }
        },
        {
            "type": "String",
            "id": "c7ff418702dd85c0a89ef8f780c7295e",
            "name": "NOMASS",
            "title": "NOMASS",
            "description": "Nom abrégé de l'assiette, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+(_gen[0-9]+)?_(mh|abor|ass|zpr1|zpr2|ziso|pepi|pepr|pepe|zhlg|zmcp|zpro|zgar|zpri|zsec|zspe|sect|zatt|zsur)",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "1ba02146c4728408a886db194ccd3647",
            "name": "HREF",
            "title": "HREF",
            "description": "Altitude de référence (SOL : terrain naturel, NGF : nivellement général de la France)",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 3
            }
        },
        {
            "type": "MultiPolygon",
            "id": "d3c58f549d79080be146be6a65a03ca3",
            "name": "WKT",
            "title": "Géométrie",
            "description": "Géométrie associée",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "Double",
            "id": "fd590771bb2f40c5bbb60cade744569e",
            "name": "H",
            "title": "H",
            "description": "Hauteur minimale ou altitude minimale de l'objet, en mètres",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        }
    ],
    "constraints": {
        "conditions": [
            "PARAMCALC IS NOT NULL OR MODEGEOASS NOT LIKE 'Zone tampon'",
            "SRCGEOASS IS NOT NULL OR MODEGEOASS NOT LIKE 'Digitalisation'"
        ],
        "foreignKeys": [
            "(MODEGEOASS) REFERENCES ListeModegeoassSUP(MODEGEOASS)",
            "(HREF) REFERENCES ListeHrefSUP(HREF)"
        ]
    }
}