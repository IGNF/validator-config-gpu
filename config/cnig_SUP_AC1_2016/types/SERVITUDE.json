{
    "id": "fb6ee937b37391592a67ca49af7007b7",
    "name": "SERVITUDE",
    "title": "SERVITUDE",
    "description": "Table contenant la liste des servitudes d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "0d7c2e464dcc0fbb24ad753579944c1f",
            "name": "VALIDEGEST",
            "title": "VALIDEGEST",
            "description": "Les données numérisées de la servitude ont été validées ou pas par le gestionnaire",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "Url",
            "id": "325db01661e42b2a38e6dd98b983dc49",
            "name": "URLREG",
            "title": "URLREG",
            "description": "Lien d’accès au fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "638f58d08d967a9ba52d02decced533d",
            "name": "DATEMAJ",
            "title": "DATEMAJ",
            "description": "Date de la dernière modification apportée à la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "([0-9]{4}((0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|0000))"
            }
        },
        {
            "type": "String",
            "id": "30abd9c2d21ce2379491b9125a70303b",
            "name": "IDSUP",
            "title": "IDSUP",
            "description": "Identifiant de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?-[0-9]{9}-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "34a570fbd634835b9de27576ff05a063",
            "name": "CATEGORIE",
            "title": "CATEGORIE",
            "description": "Catégorie de la servitude dans la nomenclature nationale",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 10
            }
        },
        {
            "type": "String",
            "id": "5e1e775b3e1d44316e30a4e9af42447e",
            "name": "QUIPROD",
            "title": "QUIPROD",
            "description": "Organisme ayant numérisé la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        },
        {
            "type": "String",
            "id": "570cf8694547b13b5aea21e0497e877a",
            "name": "OBSVALIDAT",
            "title": "OBSVALIDAT",
            "description": "Observation relative à la validation de la servitude formulée soit par le gestionnaire, soit par le service de l'État administrant les données",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "216240f9803f91a47d3ce4344137db1a",
            "name": "DESCRIPTIO",
            "title": "DESCRIPTIO",
            "description": "Description détaillée de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "e621cc4f7f5d20a7f7af796881345395",
            "name": "MODEPROD",
            "title": "MODEPROD",
            "description": "Mode d'obtention de la SUP : import de données échangées avec les gestionnaires ; numérisation (digitalisation) de la SUP annexée au document d'urbanisme ; ou reconstitution à partir de l'acte l'instituant",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "a95b3c63893c5582fa9b78d486f9bca0",
            "name": "IDGEST",
            "title": "IDGEST",
            "description": "Identifiant du gestionnaire de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{9}",
                "maxLength": 9
            }
        },
        {
            "type": "String",
            "id": "bfe805a16ac1000c1d5bf749e474cf71",
            "name": "NOMREG",
            "title": "NOMREG",
            "description": "Nom du fichier pdf contenant le règlement de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+_([0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|00000000)_reg\\.pdf",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "bf6aa5806c99fae0bb0064bd43595476",
            "name": "IDINTGEST",
            "title": "IDINTGEST",
            "description": "Identifiant créé et entretenu par l'organisme gestionnaire de la servitude",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "be695f152598afa599356eef764ad141",
            "name": "NOMSUPLITT",
            "title": "NOMSUPLITT",
            "description": "Nom littéral de la servitude, figurant dans l'acte l'ayant instaurée",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 100
            }
        },
        {
            "type": "Integer",
            "id": "2f035f61695e8c4e7e9973bec8fca924",
            "name": "ECHNUM",
            "title": "ECHNUM",
            "description": "Dénominateur de l'échelle à laquelle a été numérisée la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "96bd42d30347aa3036122713fd20e22b",
            "name": "NOMSUP",
            "title": "NOMSUP",
            "description": "Nom abrégé de la servitude, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+_sup",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "fe25b512ef3805eceb520c200a903f1a",
            "name": "DOCSOURCE",
            "title": "DOCSOURCE",
            "description": "Document graphique ayant été numérisé",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 80
            }
        }
    ],
    "constraints": {
        "conditions": [
            "QUIPROD IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'",
            "DOCSOURCE IS NOT NULL OR MODEPROD NOT LIKE 'numérisation'"
        ],
        "foreignKeys": [
            "(CATEGORIE) REFERENCES ListeCategorieSUP(CATEGORIE)",
            "(MODEPROD) REFERENCES ListeModeprodSUP(MODEPROD)",
            "(VALIDEGEST) REFERENCES ListeValidegestSUP(VALIDEGEST)",
            "(IDGEST) REFERENCES GESTIONNAIRE_SUP(IDGEST)"
        ]
    }
}