{
    "id": "9f8a01163a1908a96d50b9989722bcab",
    "name": "AC1_GENERATEUR_SUP_P",
    "title": "AC1_GENERATEUR_SUP_P",
    "description": "Table contenant les générateurs ponctuels des servitudes de la catégorie AC1",
    "columns": [
        {
            "type": "String",
            "id": "7bba4dd3cb1c1e5b6f7509b764b97f86",
            "name": "IDBDEXT",
            "title": "IDBDEXT",
            "description": "Identifiant référençant l'objet correspondant au générateur dans le référentiel ou la base de données externe",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "dce785c6fc8ba551bba801cec796f553",
            "name": "SRCGEOGEN",
            "title": "SRCGEOGEN",
            "description": "Type de carte, de référentiel géographique utilisé en tant que source de géoréférencement lors de la digitalisation de la géométrie",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 30
            }
        },
        {
            "type": "String",
            "id": "040183c4586c375feef6ee9e75c4219a",
            "name": "IDGEN",
            "title": "IDGEN",
            "description": "Identifiant du générateur",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?-[0-9]{9}-[0-9]+-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "e060626b3807cd4220c2c98cdeb68be5",
            "name": "NOMGEN",
            "title": "NOMGEN",
            "description": "Nom abrégé du générateur, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?_[A-Za-z0-9_-]+_gen([0-9]+)?",
                "maxLength": 100
            }
        },
        {
            "type": "String",
            "id": "c5e9713d9e51ee7350ec23129dac553a",
            "name": "REFBDEXT",
            "title": "REFBDEXT",
            "description": "Nom du référentiel ou de la source de données externes qui contient la géométrie du générateur obtenue par duplication",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "c6d6248b6751cb545512d32bebdbfb9b",
            "name": "DATESRCGEN",
            "title": "DATESRCGEN",
            "description": "Date d'actualité du référentiel utilisé lors de la digitalisation de l'objet. Il s'agit d'indiquer le millésime des données référentielles source",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "([0-9]{4}((0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|0000))"
            }
        },
        {
            "type": "String",
            "id": "fd405a251c0744bdfb31b115738923f1",
            "name": "MODEGENERE",
            "title": "MODEGENERE",
            "description": "Description du moyen utilisé pour obtenir la géométrie du générateur",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "4de9572307bea6b2038c3910a877000e",
            "name": "IDSUP",
            "title": "IDSUP",
            "description": "Identifiant de la SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?-[0-9]{9}-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "MultiPoint",
            "id": "0999486e9fb278fa98f9e36d2ae29ffd",
            "name": "WKT",
            "title": "Géométrie",
            "description": "Géométrie associée",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "String",
            "id": "598754116c126129cacd930c862966e0",
            "name": "TYPE",
            "title": "TYPE",
            "description": "type du monument",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 10
            }
        },
        {
            "type": "String",
            "id": "63110e68e0a502ad6df53f38be182acd",
            "name": "TYPEGEN",
            "title": "TYPEGEN",
            "description": "Nature de l'entité génératrice",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "enum": [
                    "Monument"
                ],
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "f78cdf0fade052e0f2feb5c133bc3728",
            "name": "ADRESSE",
            "title": "ADRESSE",
            "description": "Adresse du monument",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 100
            }
        }
    ],
    "constraints": {
        "conditions": [
            "SRCGEOGEN IS NOT NULL OR MODEGENERE NOT IN ('Digitalisation', 'Liste de coordonnées')",
            "DATESRCGEN IS NOT NULL OR SRCGEOGEN IS NULL",
            "REFBDEXT IS NOT NULL OR MODEGENERE NOT LIKE 'Duplication'",
            "IDBDEXT IS NOT NULL OR REFBDEXT IS NULL"
        ],
        "foreignKeys": [
            "(MODEGENERE) REFERENCES ListeModegenereSUP(MODEGENERE)",
            "(IDSUP) REFERENCES SERVITUDE(IDSUP)",
            "(TYPE) REFERENCES ListeTypeSUPMonument(TYPE)"
        ]
    }
}