{
    "description": "Variables d'affichage des expressions régulières (GpU, éditeur). Une regex par variable, toutes distinctes. Les configurations ne contiennent que les regex.",
    "variables": {
        "CATEGORIE": "[A-Za-z]{1,3}[0-9]{1,2}(bis)?",
        "CHAR": "[a-zA-Z]",
        "COULEUR": "[0-9]{3}-[0-9]{3}-[0-9]{3}",
        "DATE": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])",
        "DIGIT_9": "[0-9]{9}",
        "ENTIER": "[0-9]+",
        "ENTIER_3": "[0-9]{3}",
        "FILENAME": "[^\\/]*",
        "GEOM": "(pct|lin|surf)",
        "INSEE_COMMUNE": "[AB0-9]{5}",
        "INSEE_DEPARTEMENT": "[AB0-9]{3}",
        "INSEE_SIREN": "(\\d{9}|(2A|2B|\\d{2})\\d{3})",
        "INT_2": "[0-9]{2}",
        "MAILLAGE": "(FR|RR?[0-9]{2}|0?2[AB]|[0-9]{2,3}|(2A|2B|[0-9]{2})[0-9]{3}|[0-9]{9})",
        "NOMPROC": "[a-zA-Z]+[0-9]*",
        "RADICAL": "[A-Za-z0-9_-]+",
        "SUFFIXE_ASS": "(mh|abor|ass|zpr1|zpr2|ziso|pepi|pepr|pepe|zhlg|zmcp|zpro|zgar|zpri|zsec|zspe|sect|zatt|zsur)",
        "YYYYMMDD": "[0-9]{8}"
    }
}
