{
    "id": "a96e2badebaa115c57665a111ad88d9d",
    "name": "AR6_ASSIETTE_SUP_S",
    "title": "AR6_ASSIETTE_SUP_S",
    "description": "Table contenant les assiettes ponctuels / linéaires / surfaciques liés aux servitudes de la catégorie CAT",
    "columns": [
        {
            "type": "String",
            "id": "a583958443be5ce0de9bcdbcb9bbd140",
            "name": "TYPEASS",
            "title": "TYPEASS",
            "description": "Nature de l'assiette selon sa vocation principale et la catégorie de SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 40
            }
        },
        {
            "type": "Integer",
            "id": "e05ae7d4939407a909a5f14fae3a7f09",
            "name": "IDASS",
            "title": "IDASS",
            "description": "Identifiant de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "Integer",
            "id": "5a4240604b053f419e2566f773b032a9",
            "name": "IDGEN",
            "title": "IDGEN",
            "description": "Identifiant du générateur de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "650723eae33e85eed01bd5ded2403b1d",
            "name": "DATESRCASS",
            "title": "DATESRCASS",
            "description": "Date d'actualité du référentiel utilisé lors du géoréférencement de l'objet. Il s'agit d'indiquer le millésime des données référentielles source",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "String",
            "id": "4488900c039e9b34c29be9721c638322",
            "name": "MODEGEOASS",
            "title": "MODEGEOASS",
            "description": "Description de la méthode utilisée pour générer la géométrie de l'assiette",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "Integer",
            "id": "837d91617d8a5f416d7cc85376d26cf8",
            "name": "PARAMCALC",
            "title": "PARAMCALC",
            "description": "Valeur du paramètre ayant permis de calculer l'assiette lorsque celle-ci correspond à un objet tampon",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "5c305989b6966fe581075a8cca5121d0",
            "name": "SRCGEOASS",
            "title": "SRCGEOASS",
            "description": "Type de carte, de référentiel géographique utilisé en tant que source de géoréférencement lors de la digitalisation de la géométrie",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 30
            }
        },
        {
            "type": "String",
            "id": "8ccba029803d5f55bea861efac0cd441",
            "name": "NOMASS",
            "title": "NOMASS",
            "description": "Nom abrégé de l'assiette, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+_[A-Za-z0-9_-]+(_gen[0-9]+)?_(mh|abor|ass|zpr1|zpr2|ziso|pepi|pepr|pepe|zhlg|zmcp|zpro|zgar|zpri|zsec|zspe|sect|zatt|zsur)",
                "maxLength": 100
            }
        },
        {
            "type": "MultiPolygon",
            "id": "1fd400f20db6d49d442e3a938203811e",
            "name": "WKT",
            "title": "Géométrie",
            "description": "Géométrie associée",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true
            }
        },
        {
            "type": "Double",
            "id": "7ae83d52ae4f9034674c39eeb3e12ba8",
            "name": "H",
            "title": "H",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "String",
            "id": "e905acfc15becede0d2f3f23f7c71251",
            "name": "HREF",
            "title": "HREF",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 3
            }
        }
    ],
    "constraints": {
        "conditions": [
            "PARAMCALC IS NOT NULL OR MODEGEOASS NOT LIKE 'Zone Tampon'",
            "SRCGEOASS IS NOT NULL OR MODEGEOASS NOT LIKE 'Digitalisation'"
        ],
        "foreignKeys": [
            "(MODEGEOASS) REFERENCES ListeModegeoassSUP(MODEGEOASS)",
            "(HREF) REFERENCES ListeHrefSUP(HREF)"
        ]
    }
}