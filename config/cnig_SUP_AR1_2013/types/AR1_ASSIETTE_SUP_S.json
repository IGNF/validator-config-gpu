            "name": "H",
            "title": "H",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
            "type": "Integer",
            "id": "2fea4bab23400ce934d56366226e942d",
            "name": "ANGLE2",
            "title": "ANGLE2",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false
            }
        },
        {
