{
    "id": "a7a65b4a25ae8bfdb25961b927cf330c",
    "name": "ACTE_SUP",
    "title": "ACTE_SUP",
    "description": "Table contenant la liste des actes instituant une servitude d'utilité publique",
    "columns": [
        {
            "type": "String",
            "id": "d25ccd65133c3500598c401b67fa24f9",
            "name": "REFERENCE",
            "title": "REFERENCE",
            "description": "Référence de l'acte ayant créé ou modifié la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "e371fc4f42f40b5fb447d7c10439b712",
            "name": "DECISION",
            "title": "DECISION",
            "description": "Nature de la décision prise dans l'acte : l'autorité compétente prend une décision qui crée ou modifie l'état de la servitude",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 25
            }
        },
        {
            "type": "String",
            "id": "80cfff42d2b427c19fb6670d42687ca4",
            "name": "DATEPUB",
            "title": "DATEPUB",
            "description": "Date de parution au Journal Officiel ou de publicité dans la presse",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "Filename",
            "id": "9315bed7788cf3db5addd7bad4151212",
            "name": "FICHIER",
            "title": "FICHIER",
            "description": "Nom ou référence du ficher contenant l'acte instituant la servitude. Ce fichier contient le cas échéant les plans annexés à l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 254
            }
        },
        {
            "type": "String",
            "id": "625715829e26c8dd09cb8e122c919bed",
            "name": "IDACTE",
            "title": "IDACTE",
            "description": "Identifiant de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": true,
                "pattern": "[a-zA-Z0-9]+-[0-9]{9}-[0-9]+-[0-9]+",
                "maxLength": 40
            }
        },
        {
            "type": "String",
            "id": "11210e0debf314309690dc9a6909d109",
            "name": "APLAN",
            "title": "APLAN",
            "description": "Existence d'un ou plusieurs plans annexés à l'acte",
            "constraints": {
                "required": false,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 1
            }
        },
        {
            "type": "String",
            "id": "d2f1b33ba267212416ef4291c7ceef03",
            "name": "TYPEACTE",
            "title": "TYPEACTE",
            "description": "Description de la nature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "maxLength": 50
            }
        },
        {
            "type": "String",
            "id": "b108e616fcf4b1267907cbf180c92dd1",
            "name": "DATEDECIS",
            "title": "DATEDECIS",
            "description": "Date à laquelle la décision a été prise. Il s'agit de la date de signature de l'acte",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])"
            }
        },
        {
            "type": "String",
            "id": "cd558ce0c5b07b7d5f431aaf8fd0aa9d",
            "name": "NOMACTE",
            "title": "NOMACTE",
            "description": "Nom abrégé de l'acte, respectant les règles de nommage nationales des SUP",
            "constraints": {
                "required": true,
                "presenceRequired": true,
                "unique": false,
                "pattern": "[a-zA-Z0-9]+_[A-Za-z0-9_-]+_[0-9]{8}_act",
                "maxLength": 100
            }
        }
    ],
    "constraints": {
        "conditions": [],
        "foreignKeys": [
            "(APLAN) REFERENCES ListeAplanSUP(APLAN)",
            "(DECISION) REFERENCES ListeDecisionSUP(DECISION)",
            "(TYPEACTE) REFERENCES ListeTypeacteSUP(TYPEACTE)"
        ]
    }
}